{
  "manifest_version": 3,
  "name": "Ссылки без меток ChatGPT",
  "version": "1.0.0",
  "description": "Убирает метки ChatGPT из адреса и скрывает источник перехода от сайта.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-link-cleaner@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chatgpt.com/*",
        "*://*.chat.openai.com/*"
      ],
      "js": [
        "links.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
